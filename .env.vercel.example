APP_NAME="AI Study Assistant"
APP_ENV=production
APP_KEY=base64:AgtBhYqPwmRXbp52I8EpymkeWoTqomEtVugFMria0ZE=
APP_DEBUG=false
APP_URL=https://your-backend-project.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Cloud Database configuration (e.g. TiDB Cloud / Aiven / Supabase)
DB_CONNECTION=mysql
DB_HOST=your-cloud-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password
# Optional: If your cloud database requires SSL (like TiDB or Aiven):
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

SESSION_DRIVER=cookie
SESSION_ENCRYPT=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Frontend URL (no trailing slash)
CORS_ALLOWED_ORIGINS=https://ai-powered-intelligent-study-assist.vercel.app

# AI Service Keys (optional / as needed)
OPENROUTER_API_KEY=
AI_GATEWAY_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-3.5-turbo
AI_GATEWAY_KEY=
