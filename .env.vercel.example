APP_NAME="AI Study Assistant"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api-project.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=your-database-name
DB_USERNAME=your-database-user
DB_PASSWORD=your-database-password

SESSION_DRIVER=cookie
SESSION_ENCRYPT=false
CACHE_STORE=array
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

CORS_ALLOWED_ORIGINS=https://your-frontend-project.vercel.app,https://your-custom-domain.com

OPENROUTER_API_KEY=
AI_GATEWAY_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-3.5-turbo
AI_GATEWAY_KEY=
